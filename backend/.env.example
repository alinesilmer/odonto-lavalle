# Copy to backend/.env and fill in. Never commit the filled-in file.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

# --- Firebase Admin service account ---------------------------------------
# Firebase console > Project settings > Service accounts > Generate new private key.
# Take these three values out of the downloaded JSON.
FIREBASE_PROJECT_ID=odonto-lavalle
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@odonto-lavalle.iam.gserviceaccount.com
# Keep the surrounding quotes and the literal \n escapes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=odonto-lavalle.appspot.com

# --- Firebase Web API key --------------------------------------------------
# Project settings > General > Web app > apiKey. Used for password sign-in.
FIREBASE_WEB_API_KEY=AIzaSy...

# --- Clinic scheduling -----------------------------------------------------
CLINIC_TIMEZONE=America/Argentina/Buenos_Aires
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=18
APPOINTMENT_MINUTES=30
