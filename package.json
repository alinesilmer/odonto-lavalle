{
  "name": "odonto-lavalle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:api": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=frontend",
    "test:ci": "npm run test:ci --workspace=frontend",
    "firebase:cleanup": "npm run cleanup --workspace=backend"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
